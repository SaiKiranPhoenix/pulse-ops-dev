NODE_ENV=development
PORT=4100
MONGODB_URI=mongodb://mongodb:27017/pulseops
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://pulseops_local:set-local-rabbitmq-password@rabbitmq:5672
JWT_SECRET=set-local-jwt-secret-minimum-32-characters
API_KEY_PEPPER=replace-with-local-api-key-pepper-minimum-32-characters
RATE_LIMIT_PER_MINUTE=600
