{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API Gateway",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
      "runtimeArgs": ["watch", "${workspaceFolder}/po-api-gateway/src/server.ts"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.local",
      "env": {
        "NODE_ENV": "development",
        "PORT": "4000",
        "MONGODB_URI": "mongodb://localhost:27018/pulseops",
        "REDIS_URL": "redis://localhost:6379",
        "AUTH_PROJECT_SERVICE_URL": "http://localhost:4010",
        "AUDIT_SERVICE_URL": "http://localhost:4140",
        "INGESTION_SERVICE_URL": "http://localhost:4100",
        "INCIDENT_SERVICE_URL": "http://localhost:4120",
        "OPS_SERVICE_URL": "http://localhost:4150",
        "VAULT_SERVICE_URL": "http://localhost:4200"
      },
      "sourceMaps": true,
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Auth / Projects Service",
      "type": "node",
