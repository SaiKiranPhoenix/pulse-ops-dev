NODE_ENV=development

MONGODB_URI=mongodb://mongodb:27017/pulseops
REDIS_URL=redis://redis:6379
RABBITMQ_DEFAULT_USER=pulseops_local
RABBITMQ_DEFAULT_PASS=set-local-rabbitmq-password
RABBITMQ_URL=amqp://pulseops_local:set-local-rabbitmq-password@rabbitmq:5672

JWT_SECRET=set-local-jwt-secret-minimum-32-characters
API_KEY_PEPPER=replace-with-local-api-key-pepper-minimum-32-characters
RATE_LIMIT_PER_MINUTE=600
VAULT_MASTER_PASSWORD=replace-with-local-vault-master-password
VAULT_TOKEN_PEPPER=replace-with-local-vault-token-pepper
OAUTH_STATE_SECRET=set-local-oauth-state-secret-minimum-32-characters
OAUTH_STATE_TTL_SECONDS=300
OAUTH_CALLBACK_BASE_URL=http://localhost:4000
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/oauth/callback
OAUTH_FAILURE_REDIRECT_URL=http://localhost:3000/login
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
API_GATEWAY_PORT=4000
AUTH_PROJECT_SERVICE_PORT=4010
INGESTION_SERVICE_PORT=4100
EVENT_WORKERS_PORT=4110
WORKER_ID=po-event-workers-local
WORKER_PREFETCH=10
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_HEARTBEAT_TTL_SECONDS=30
INCIDENT_SERVICE_PORT=4120
INCIDENT_WORKER_PREFETCH=10
REALTIME_GATEWAY_PORT=4130
REALTIME_WORKER_PREFETCH=10
AUDIT_SERVICE_PORT=4140
AUDIT_WORKER_PREFETCH=10
OPS_SERVICE_PORT=4150
VAULT_SERVICE_PORT=4200

AUTH_PROJECT_SERVICE_URL=http://po-auth-project-service:4010
AUDIT_SERVICE_URL=http://po-audit-service:4140
INGESTION_SERVICE_URL=http://po-ingestion-service:4100
INCIDENT_SERVICE_URL=http://po-incident-service:4120
OPS_SERVICE_URL=http://po-ops-service:4150
VAULT_SERVICE_URL=http://po-vault-service:4200

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PULSEOPS_API_BASE_URL=http://localhost:4000
PULSEOPS_REALTIME_URL=http://localhost:4130
VITE_API_BASE_URL=http://localhost:4000
VITE_REALTIME_URL=http://localhost:4130
VITE_SOCKET_URL=http://localhost:4130
